# Konfigurasi PROXY (runtime) - jangan pakai VITE_ di sini.
# Salin file ini ke .env.local-proxy lalu isi nilainya.
SUPABASE_URL=https://qkdosuplybkdfdwuzzxx.supabase.co
ANON_KEY=sb_publishable_Vd-sNPBRfDMesXYEJu-z9w_IZGx39n7
HOST=0.0.0.0
PORT=8000

# Storage driver:
#   supabase (default) = Supabase Storage
#   local              = simpan file di disk komputer ini (TANPA Cloudflare,
#                        TANPA PostgreSQL). Disarankan untuk LAN/offline.
#   r2                 = Cloudflare R2 lewat Worker
STORAGE_DRIVER=local

# Khusus STORAGE_DRIVER=local:
# Folder penyimpanan foto (relatif ke folder proyek atau absolut).
STORAGE_DIR=storage-data
# Batas ukuran per file (byte). Default 5 MB.
STORAGE_MAX_BYTES=5242880
# Wajibkan token login Supabase saat upload/hapus. Set false hanya untuk uji.
STORAGE_REQUIRE_AUTH=true

# Khusus STORAGE_DRIVER=r2:
# R2_PUBLIC_URL=https://photos.example.com
# STORAGE_API_URL=https://monitoring-storage.example.workers.dev
