# Konfigurasi PROXY (runtime) - jangan pakai VITE_ di sini.
# Salin file ini ke .env.local-proxy lalu isi nilainya.
SUPABASE_URL=https://qkdosuplybkdfdwuzzxx.supabase.co
ANON_KEY=sb_publishable_Vd-sNPBRfDMesXYEJu-z9w_IZGx39n7
HOST=0.0.0.0

# DUA PORT TERPISAH (dipakai server\start-foto-tunnel.bat):
#   APP_PORT    : proxy aplikasi (bridge) untuk komputer LAN
#   TUNNEL_PORT : proxy khusus foto yang diekspos Cloudflare Tunnel
APP_PORT=8000
TUNNEL_PORT=8001
# PORT dipakai bila menjalankan satu instance saja (npm run start:proxy).
PORT=8000

# Storage driver:
#   supabase (default) = Supabase Storage
#   local              = simpan file di disk komputer ini (TANPA Cloudflare,
#                        TANPA PostgreSQL). Disarankan untuk LAN/offline.
#   r2                 = Cloudflare R2 lewat Worker
STORAGE_DRIVER=local

# Khusus STORAGE_DRIVER=local:
# Folder penyimpanan foto (relatif ke folder proyek atau absolut).
STORAGE_DIR=storage-data
# Batas ukuran per file (byte). Default 5 MB.
STORAGE_MAX_BYTES=5242880
# Wajibkan token login Supabase saat upload/hapus. Set false hanya untuk uji.
STORAGE_REQUIRE_AUTH=true

# CORS: origin browser yang boleh mengakses proxy.
#   '*' = semua origin (default, cocok untuk uji coba)
#   'https://monitoreng.pages.dev' = hanya aplikasi produksi
# Bisa beberapa origin dipisah koma.
ALLOWED_ORIGIN=*

# Set true bila proxy foto (TUNNEL_PORT) diekspos ke internet lewat Cloudflare
# Tunnel. Semua path selain /photos/* dan /storage-api/* akan 404.
# Instance aplikasi (APP_PORT) memakai --role=app sehingga nilai ini diabaikan.
STORAGE_ONLY=false

# MODE BRIDGE (opsional): teruskan aplikasi ke URL upstream, mis.
#   APP_UPSTREAM_URL=https://monitoreng.pages.dev
# Dengan ini komputer lain di LAN bisa membuka aplikasi lewat PC ini:
#   http://<IP-PC-ini>:8000/
# Foto tetap dilayani dari disk lokal (/photos/*).
# Kosongkan bila ingin menyajikan folder dist/ hasil `npm run build:proxy`.
# APP_UPSTREAM_URL=

# Saat mode bridge, URL absolut di bundle ditulis ulang menjadi origin proxy
# agar klien LAN cukup menghubungi PC ini (tidak perlu internet).
# Pisahkan dengan koma. Default bila kosong: SUPABASE_URL.
# BRIDGE_REWRITE=https://xxx.supabase.co,https://foto.woeng.my.id

# Khusus STORAGE_DRIVER=r2:
# R2_PUBLIC_URL=https://photos.example.com
# STORAGE_API_URL=https://monitoring-storage.example.workers.dev
