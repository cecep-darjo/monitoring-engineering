# ============================================================
# KONFIGURASI LOCAL PROXY SERVER
# Salin file ini menjadi `.env.local-proxy` lalu isi nilainya.
# (JANGAN commit `.env.local-proxy` — isinya rahasia.)
# ============================================================

# URL Supabase project (backend yang punya akses internet ORANG lain,
# tapi request-nya diteruskan keluar oleh proxy di komputer lokal ini).
SUPABASE_URL=https://xzyglfiecvmwsatpiemy.supabase.co

# Supabase ANON key (dipakai proxy sebagai header fallback untuk request
# tanpa header apikey, mis. foto public object di <img>).
ANON_KEY=sb_publishable_LfhqaupabddAgKjtTbzNAQ_uFpQ83Pr

# Host/IP proxy. 0.0.0.0 = didengar di semua antarmuka (bisa diakses LAN).
HOST=0.0.0.0

# Port proxy. (8080 mungkin terpakai, jadi default dipakai 4000.)
# Bisa diset 80 jika ingin akses tanpa mengetik port di URL.
PORT=4000