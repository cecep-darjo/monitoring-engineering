VITE_SUPABASE_URL=https://qkdosuplybkdfdwuzzxx.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_Vd-sNPBRfDMesXYEJu-z9w_IZGx39n7

# Storage driver: "supabase" (default), "local" (disk server sendiri), atau "r2".
VITE_STORAGE_DRIVER=supabase
# Khusus "local": alamat publik server yang menyajikan /photos/*.
# Kosongkan bila aplikasi diakses lewat proxy yang sama.
# VITE_STORAGE_PUBLIC_URL=http://192.168.1.10:8000

# Deploy statis (Cloudflare Pages) + foto di folder lokal server proxy:
# isi DUA variabel di bawah dengan URL publik server proxy (mis. Cloudflare Tunnel).
# Bila keduanya terisi, `npm run build:cloudflare` otomatis memakai driver "local".
# VITE_STORAGE_PUBLIC_URL=https://foto.example.com
# VITE_STORAGE_API_URL=https://foto.example.com/storage-api

# Wajib bila VITE_STORAGE_DRIVER=r2:
# VITE_R2_PUBLIC_URL=https://photos.example.com
# VITE_STORAGE_API_URL=https://monitoring-storage.example.workers.dev